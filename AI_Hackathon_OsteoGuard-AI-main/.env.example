# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored; never commit a real key.

GROQ_API_KEY=your_groq_api_key_here

# --- Models -----------------------------------------------------------------
# Answering and summarising are tuned separately so that changing one cannot
# regress the other. Both default to openai/gpt-oss-120b.
# ASSISTANT_MODEL=openai/gpt-oss-120b
# SUMMARY_MODEL=openai/gpt-oss-120b

# Temperatures are measured settings. At 1.0 this model family drops into runs
# of filler characters that truncate the output; do not raise without retesting.
# ASSISTANT_TEMPERATURE=0.2
# SUMMARY_TEMPERATURE=0.2

# --- Retrieval --------------------------------------------------------------
# accurate (default, ~14s), balanced (~6s), or fast (~4s)
# OSTEOGUARD_MODE=accurate

# --- Optional: switch generation back to Google Gemini ----------------------
# Requires `pip install google-generativeai` (the SDK is end-of-life).
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
